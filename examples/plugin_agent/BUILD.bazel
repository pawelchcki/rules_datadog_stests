load("@rules_stests//rules:defs.bzl", "corpus_service", "realworld_service_tests")
load("@rules_datadog_stests//rules:defs.bzl", "datadog_env", "datadog_python_injection", "datadog_realworld_profile")
load(":api_check.bzl", "telemetry_api_check")
package(default_visibility = ["//visibility:public"])
_DATADOG_REFERENCE_SCENARIOS = [
    "articles", "auth", "comments", "errors_articles", "errors_auth",
    "errors_authorization", "errors_comments", "errors_profiles", "favorites",
    "feed", "pagination", "profiles", "propagation", "tags", "unicode",
    "propagation_datadog",
]

# A consumer-owned Datadog profile exercises independent schema-v2 proof plans.
datadog_realworld_profile(
    name = "example-aiohttp-datadog-v4-15-4",
    specification = "profile/example-aiohttp-datadog-v4-15-4.scm",
    implementation_libraries = ["@rules_datadog_stests//corpus:datadog/implementation/python-v4.15.4.scm"],
    wire_version = "v0.5",
    reference_profile = "@rules_datadog_stests//corpus:python-aiohttp-datadog-v4-15-4-v05",
)

corpus_service(
    name = "example_datadog_service",
    rootfs = "@rules_stests//harness:aiohttp_rootfs",
    runtime = "python",
    instance = "example-aiohttp-datadog",
    command = "serve",
    args = ["--host", "127.0.0.1", "--port", "$${PORT}"],
    env = datadog_env(service = "example-aiohttp-datadog"),
    injection = datadog_python_injection(aiohttp = True),
    deps = ["@rules_stests//harness:telemetry_sink_service"],
    autoassign_port = True,
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    hygienic = False,
    shutdown_timeout = "10s",
    so_reuseport_aware = True,
)

realworld_service_tests(
    name = "example_datadog",
    service = ":example_datadog_service",
    telemetry_profile = ":example-aiohttp-datadog-v4-15-4",
    telemetry_sink = "@rules_stests//harness:telemetry_sink_service",
    scenarios = _DATADOG_REFERENCE_SCENARIOS,
)

datadog_realworld_profile(
    name = "example-django-datadog-v4-15-4",
    specification = "profile/example-django-datadog-v4-15-4.scm",
    implementation_libraries = ["@rules_datadog_stests//corpus:datadog/implementation/python-v4.15.4.scm"],
    wire_version = "v0.5",
    reference_profile = "@rules_datadog_stests//corpus:python-django-datadog-v4-15-4-v05",
)

corpus_service(
    name = "example_django_datadog_service",
    rootfs = "@rules_stests//harness:django_rootfs",
    runtime = "python",
    instance = "example-django-datadog",
    command = "serve",
    args = ["--host", "127.0.0.1", "--port", "$${PORT}"],
    env = datadog_env(service = "example-django-datadog"),
    injection = datadog_python_injection(),
    deps = ["@rules_stests//harness:telemetry_sink_service"],
    autoassign_port = True,
    expected_start_duration = "3s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    hygienic = False,
    shutdown_timeout = "10s",
    so_reuseport_aware = True,
)

realworld_service_tests(
    name = "example_django_datadog",
    service = ":example_django_datadog_service",
    telemetry_profile = ":example-django-datadog-v4-15-4",
    telemetry_sink = "@rules_stests//harness:telemetry_sink_service",
    scenarios = _DATADOG_REFERENCE_SCENARIOS,
)

# Re-export the controlled native emitter check so an external module verifies
# that a consumer-declared tracer identity is accepted and a mismatch rejected.
test_suite(
    name = "datadog_consumer_identity_test",
    tests = ["@rules_datadog_stests//corpus:datadog_conformance_test"],
)

telemetry_api_check(name = "telemetry_api_check", datadog_profile = ":example-aiohttp-datadog-v4-15-4")
