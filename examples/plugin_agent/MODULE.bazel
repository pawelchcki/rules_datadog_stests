module(name = "rules_datadog_stests_example")
bazel_dep(name = "rules_datadog_stests", version = "0.0.0")
bazel_dep(name = "rules_stests", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")
local_path_override(module_name = "rules_datadog_stests", path = "../..")

# Make the prepared Go app repository visible to --override_repository.
go_runtime = use_extension("@rules_datadog_stests//bazel:go_runtime_deps.bzl", "go_runtime_deps")
use_repo(go_runtime, "go_runtime_apps")
# Overrides only apply in root modules; mirror the infrastructure pin.
git_override(
    module_name = "rules_stests",
    remote = "https://github.com/pawelchcki/rules_stests.git",
    commit = "db94b7ae98d1c8765b2ec236f6732683bbbfb54d",
    patches = ["//:rules_stests_django_bind.patch"],
    patch_strip = 1,
)
