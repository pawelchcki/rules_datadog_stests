_PYTHON_ARGS = ["--host", "127.0.0.1", "--port", "$${PORT}"]
corpus_service(
    name = "aiohttp_datadog_service",
    rootfs = "@rules_stests//harness:aiohttp_rootfs",
    runtime = "python",
    instance = "aiohttp-datadog",
    command = "serve",
    args = _PYTHON_ARGS,
    injection = datadog_python_injection(aiohttp = True),
    env = datadog_env(service = "aiohttp-datadog", wire_version = "v0.5"),
    deps = ["@rules_stests//harness:telemetry_sink_service"],
    so_reuseport_aware = True,
    autoassign_port = True,
    expected_start_duration = "5s",
    http_health_check_address = "http://127.0.0.1:$${PORT}/api/tags",
    hygienic = False,
    shutdown_timeout = "10s",
)

