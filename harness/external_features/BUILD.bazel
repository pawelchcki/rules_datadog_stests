load("@rules_go//go:def.bzl", "go_binary", "go_test")

package(default_visibility = ["//visibility:public"])

_SRCS = [
    "main.go",
    "datadog.go",
    "datadog_probes.go",
    "datadog_shared.go",
    "@rules_stests//harness/external_features:probe_runtime",
]

go_binary(name = "probe", srcs = _SRCS)

go_test(
    name = "probe_test",
    srcs = _SRCS + ["datadog_test.go", "datadog_probes_test.go", "datadog_shared_test.go"],
    data = [
        "//docs:datadog-capabilities-inventory.json",
        "//docs:datadog-shared-capabilities-mapping.json",
    ],
)
