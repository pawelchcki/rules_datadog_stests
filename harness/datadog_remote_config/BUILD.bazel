load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
package(default_visibility = ["//visibility:public"])
exports_files(["workload.py"])
py_library(
    name = "remote_config_lib",
    srcs = ["assertions.py", "backend.py", "probe.py"],
    data = ["signed-fixtures.json", "schema.json", "vendor/remoteconfig.proto"],
    deps = ["//harness/datadog_agent:agent_lib", "//harness/datadog_backend:backend_lib", "//harness/datadog_llmobs:llmobs_lib", "//harness/datadog_telemetry:telemetry_lib"],
)
py_binary(name = "probe", srcs = ["probe.py"], main = "probe.py", deps = [":remote_config_lib"])
py_test(name = "assertions_test", srcs = ["assertions_test.py"], main = "assertions_test.py", data = ["golden.json"], deps = [":remote_config_lib"])
