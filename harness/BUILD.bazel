load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("@rules_itest//:itest.bzl", "service_test")
load("@rules_stests//rules:defs.bzl", "corpus_service", "oci_rootfs")
load("@rules_stests//harness:scheme_bytecode.bzl", "scheme_bytecode_bundles")
load("//corpus:registry.bzl", "DATADOG_CAPTURE_LIBRARIES", "datadog_library_args", "datadog_library_labels")
package(default_visibility = ["//visibility:public"])
# Compatibility for the shared compiler macro in the pinned infrastructure release.
alias(name = "telemetry_sink", actual = "@rules_stests//harness:telemetry_sink")
alias(name = "telemetry_sink_service", actual = "@rules_stests//harness:telemetry_sink_service")
oci_rootfs(
    name = "datadog_python_rootfs",
    image = "@datadog_python_linux_amd64",
)

go_binary(
    name = "datadog_sink_probe",
    srcs = ["datadog_sink_probe.go"],
    deps = ["@rules_stests//harness:schemebytecode"],
)

# The probe's fixed validation programs, compiled at build time.
_SINK_PROBE_BYTECODE = scheme_bytecode_bundles(
    name = "datadog_sink_probe_bytecode",
    libraries = datadog_library_labels(DATADOG_CAPTURE_LIBRARIES),
    probe = ":datadog_sink_probe",
    shards = 2,
)



service_test(
    name = "datadog_sink_test",
    timeout = "long",
    args = [
        "--service-suffix=//harness:telemetry_sink_service",
        "--compiler=$(rootpath @rules_stests//harness:telemetry_sink)",
    ] + _SINK_PROBE_BYTECODE.args + datadog_library_args(DATADOG_CAPTURE_LIBRARIES),
    data = ["@rules_stests//harness:telemetry_sink"] + _SINK_PROBE_BYTECODE.data + datadog_library_labels(DATADOG_CAPTURE_LIBRARIES),
    services = [":telemetry_sink_service"],
    test = ":datadog_sink_probe",
)

oci_rootfs(
    name = "datadog_ruby_rootfs",
    image = "@datadog_ruby_linux_amd64",
    single_payload = True,
    tags = ["manual"],
)

corpus_service(
    name = "datadog_stress_sink_service",
    args = ["--port", "$${PORT}", "--output", "$${TMPDIR}/datadog-stress.json", "--stress-capture"],
    autoassign_port = True,
    exe = ":telemetry_sink",
    http_health_check_address = "http://127.0.0.1:$${PORT}/healthz",
    so_reuseport_aware = True,
    shutdown_timeout = "2s",
    tags = ["manual"],
)


oci_rootfs(
    name = "gin_datadog_rootfs",
    image = "@gin_datadog_realworld_linux_amd64",
    single_payload = True,
    tags = ["manual"],
)

go_test(
    name = "datadog_ruby_bootstrap_test",
    srcs = ["ruby_bootstrap_test.go"],
    embed = ["@rules_stests//harness:app_launcher_lib"],
    data = ["@rules_stests//harness:rails_rootfs", ":datadog_ruby_rootfs"],
    env = {"RAILS_ROOTFS": "$(rlocationpath @rules_stests//harness:rails_rootfs)", "DATADOG_RUBY_ROOTFS": "$(rlocationpath :datadog_ruby_rootfs)"},
    tags = ["manual"],
)
