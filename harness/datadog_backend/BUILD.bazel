load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "backend_lib",
    srcs = ["backend.py", "wire.py"],
    data = ["schema.json", "metrics_schema.json", "vendor/agent_payload.proto"],
)

py_binary(
    name = "server",
    srcs = ["main.py"],
    main = "main.py",
    deps = [":backend_lib"],
)

py_test(
    name = "backend_test",
    srcs = ["backend_test.py"],
    main = "backend_test.py",
    deps = [":backend_lib"],
)
