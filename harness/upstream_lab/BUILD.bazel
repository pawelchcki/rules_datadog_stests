load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["vendor/manifest.json"])

filegroup(
    name = "upstream_sources",
    srcs = glob(["vendor/**"]),
)

py_binary(
    name = "probe",
    srcs = ["adapter.py", "expected_failures.py", "local_cases.py", "probe.py"],
    data = ["exclusions.json", ":upstream_sources"],
    main = "probe.py",
    python_version = "PY3",
)

py_test(
    name = "adapter_unit_test",
    srcs = ["adapter.py", "adapter_test.py", "expected_failures.py"],
    data = ["expected_failure_fixtures.json", ":upstream_sources"],
    main = "adapter_test.py",
    python_version = "PY3",
)
