module(name = "rules_datadog_stests", version = "0.0.0")
bazel_dep(name = "rules_stests", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_itest", version = "0.0.59")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
# Pin the latest shared infrastructure, including the versioned Ruby runtime matrix.
git_override(
    module_name = "rules_stests",
    remote = "https://github.com/pawelchcki/rules_stests.git",
    commit = "402ce4e9eeb9dab79d20ad11b7967c2604ca39a2",
    patches = ["//bazel:rules_stests_django_bind.patch", "//bazel:rules_stests_ruby_context.patch", "//bazel:rules_stests_probe_readiness.patch"],
    patch_strip = 1,
)
images = use_extension("//bazel:oci_deps.bzl", "oci_deps")
use_repo(images, "datadog_python", "datadog_python_linux_amd64", "datadog_ruby", "datadog_ruby_linux_amd64", "datadog_agent", "datadog_agent_linux_amd64", "gin_datadog_realworld", "gin_datadog_realworld_linux_amd64", "datadog_mariadb", "datadog_mariadb_linux_amd64")
wheel_deps = use_extension("//bazel:wheel_deps.bzl", "wheel_deps")
wheel_deps.bundle(name = "openai_wheels", lock = "//bazel:openai_wheels.lock.json")
wheel_deps.bundle(name = "otel_wheels", lock = "//bazel:otel_wheels.lock.json")
wheel_deps.bundle(name = "ffe_wheels", lock = "//bazel:ffe_wheels.lock.json")
wheel_deps.bundle(name = "integrations_wheels", lock = "//bazel:integrations_wheels.lock.json")
wheel_deps.bundle(name = "security_extra_wheels", lock = "//bazel:security_extra_wheels.lock.json")
wheel_deps.bundle(name = "messaging_wheels", lock = "//bazel:messaging_wheels.lock.json")
wheel_deps.bundle(name = "sca_wheels", lock = "//bazel:sca_wheels.lock.json")
use_repo(wheel_deps, "sca_wheels", "messaging_wheels", "openai_wheels", "otel_wheels", "ffe_wheels", "integrations_wheels", "security_extra_wheels")
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//harness/shared_sdk/go:go.mod")
# Gazelle overrides are root-only. Keep public dependency discovery available
# to consumers while ignoring these build preferences in non-root modules.
go_deps_config = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_config.gazelle_default_attributes(build_extra_args = ["-proto=disable_global"])
# Agent modules ship monorepo BUILD files; generate module-local targets instead.
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/comp/core/tagger/origindetection",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/obfuscate",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/opentelemetry-mapping-go/otlp/attributes",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/proto",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/remoteconfig/state",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/trace",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/trace/log",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/trace/stats",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
go_deps_config.gazelle_override(
    path = "github.com/DataDog/datadog-agent/pkg/trace/traceutil",
    build_file_generation = "clean",
    build_extra_args = ["-proto=disable_global"],
)
use_repo(go_deps, "com_github_datadog_dd_trace_go_v2", "com_github_datadog_dd_trace_go_contrib_net_http_v2", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_trace")
go_runtime_apps = use_extension("//bazel:go_runtime_deps.bzl", "go_runtime_deps")
use_repo(go_runtime_apps, "go_runtime_apps")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "datadog_system_tests_headers",
    downloaded_file_path = "test_headers_datadog.py",
    sha256 = "eae879d44ecf020bb1f4a2899d78f2027c9942e556baf406932c2f9ad6905b43",
    urls = ["https://raw.githubusercontent.com/DataDog/system-tests/ea8a5976064509df0a5232e314b22e7e90ca4d40/tests/parametric/test_headers_datadog.py"],
)

ruby_datadog = use_extension("//bazel:datadog_ruby.bzl", "datadog_ruby")
use_repo(ruby_datadog, "datadog_ruby_matrix_config", "datadog_gem_datadog", "datadog_gem_cgi", "datadog_gem_datadog_ruby_core_source", "datadog_gem_libdatadog", "datadog_gem_libddwaf", "datadog_gem_logger", "datadog_gem_msgpack", "datadog_gem_ffi")
