module(name = "rules_datadog_stests", version = "0.0.0")
bazel_dep(name = "rules_stests", version = "0.0.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_itest", version = "0.0.59")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
# Pin the infrastructure; the small compatibility patch exposes shared probe
# sources and application inputs. Drop the patch when the infrastructure split is published and pinned.
git_override(
    module_name = "rules_stests",
    remote = "https://github.com/pawelchcki/rules_stests.git",
    commit = "11b5e4768eb63f3b7328b742278e90fcaa30b8a6",
    patches = ["//third_party:rules_stests.patch"],
    patch_strip = 1,
)
images = use_extension("//bazel:oci_deps.bzl", "oci_deps")
use_repo(images, "datadog_python", "datadog_python_linux_amd64", "datadog_ruby", "datadog_ruby_linux_amd64", "gin_datadog_realworld", "gin_datadog_realworld_linux_amd64")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "datadog_system_tests_headers",
    downloaded_file_path = "test_headers_datadog.py",
    sha256 = "eae879d44ecf020bb1f4a2899d78f2027c9942e556baf406932c2f9ad6905b43",
    urls = ["https://raw.githubusercontent.com/DataDog/system-tests/ea8a5976064509df0a5232e314b22e7e90ca4d40/tests/parametric/test_headers_datadog.py"],
)
