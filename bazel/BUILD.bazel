# Keep public CI independent of the executor policy in the pinned rules_stests
# dependency: that revision still selects a private runner pool.
platform(
    name = "rbe_linux_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        # The Python fixture needs the standard image's timezone database.
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:f7db0d4791247f032fdb4451b7c3ba90e567923a341cc6dc43abfc283436791a",
        "use-self-hosted-executors": "false",
    },
)
