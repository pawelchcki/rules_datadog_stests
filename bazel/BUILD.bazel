# Keep public CI independent of the executor policy in the pinned rules_stests
# dependency: that revision still selects a private runner pool.
platform(
    name = "rbe_linux_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
