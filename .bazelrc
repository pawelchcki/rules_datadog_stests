common --enable_bzlmod
common --@@rules_python+//python/config_settings:bootstrap_impl=script
build --nostamp
build --incompatible_strict_action_env
common:local --remote_executor= --remote_cache= --bes_backend=
common:local --spawn_strategy=sandboxed,local
# Lazy cached tree inputs can replace OCI directory aliases with partial directories.
common:local --remote_download_outputs=all
common:local --extra_execution_platforms= --host_platform=@platforms//host
# Actions execute locally while sharing BuildBuddy's authenticated cache when
# available. Forks have no API key and retain the setup-bazel disk cache.
common:ci-cache --config=local
common:ci-cache --config=buildbuddy-cache
common:buildbuddy-cache --remote_upload_local_results=false
# The credential and remote_cache endpoint are installed in the runner's
# user bazelrc, never in this public repository.
test --test_output=errors

# Optional BuildBuddy fleet, using the shared execution platform.
common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
common:buildbuddy --bes_results_url=https://pawel.buildbuddy.io/invocation/
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_timeout=10m
common:buildbuddy --remote_download_outputs=minimal
# Bazel 7+ minimal downloads no longer disable eager runfiles trees. Remote
# actions materialize their runfiles on the executor; local actions build them
# on demand. Avoid thousands of unused client-side trees in each CI shard.
common:buildbuddy --nobuild_runfile_links
common:buildbuddy --remote_local_fallback=false
common:buildbuddy --remote_upload_local_results=false
common:buildbuddy --spawn_strategy=remote
common:buildbuddy --jobs=100
common:buildbuddy --extra_execution_platforms=@rules_stests//bazel/platforms:rbe_linux_amd64
common:buildbuddy --host_platform=@rules_stests//bazel/platforms:rbe_linux_amd64
build:buildbuddy --build_metadata=VISIBILITY=PUBLIC
